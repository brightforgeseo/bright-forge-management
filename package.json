{
  "name": "bright-forge-portal",
  "version": "1.0.322",
  "description": "Bright Forge Team Portal",
  "main": "electron.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "start": "parcel index.html",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.cjs tests/*.test.mjs",
    "build": "rm -rf .parcel-cache && node scripts/clean-web-dist.cjs && parcel build index.html --public-url ./ && node scripts/copy-public.cjs",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:1234 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:linux": "SUPABASE_URL=http://127.0.0.1:8080/supabase npm run build && electron-builder --linux AppImage --x64 --publish never",
    "portal:server": "node scripts/portal-server.cjs",
    "deploy:watch": "node scripts/auto-deploy-watch.cjs",
    "release:update": "node scripts/release-portal-update.cjs",
    "release:update:dry-run": "node scripts/release-portal-update.cjs --dry-run",
    "release:update:local": "node scripts/release-portal-update.cjs --allow-unpublished",
    "release:verify": "node scripts/verify-release-surfaces.cjs",
    "cap:sync": "npx cap sync",
    "mobile:build": "npm run build && npx cap sync",
    "ios:open": "npx cap open ios",
    "android:open": "npx cap open android",
    "test:business-os": "node --test tests/business-os-model.test.mjs tests/business-os-integration.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@daily-co/daily-js": "^0.85.0",
    "@google/genai": "^1.30.0",
    "@supabase/supabase-js": "^2.83.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.554.0",
    "openai": "^6.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-raw": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.17",
    "buffer": "6.0.3",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "parcel": "^2.16.4",
    "postcss": "^8.5.23",
    "process": "^0.11.10",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "wait-on": "^7.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": {
        "global-agent": "4.1.3"
      }
    },
    "tailwindcss": {
      "postcss-selector-parser": "7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  },
  "build": {
    "appId": "com.brightforge.portal",
    "productName": "Bright Forge Portal",
    "artifactName": "BrightForgePortal-${version}-${arch}-${os}.${ext}",
    "afterPack": "scripts/afterpack.cjs",
    "files": [
      "dist/**/*",
      "!dist/*.AppImage",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/linux-unpacked{,/**}",
      "!dist/win-unpacked{,/**}",
      "electron.js",
      "package.json",
      "assets/**/*",
      "preload.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "owner": "brightforgeseo",
      "repo": "bright-forge-management"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "signAndEditExecutable": false,
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
