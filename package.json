{
  "name": "bright-forge-portal",
  "version": "1.0.294",
  "description": "Bright Forge Team Portal",
  "main": "electron.js",
  "targets": {
    "main": false
  },
  "scripts": {
    "start": "parcel index.html",
    "build": "rm -rf .parcel-cache dist && parcel build index.html --public-url ./ && node scripts/copy-public.cjs",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:1234 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "release:update": "node scripts/release-portal-update.cjs",
    "release:update:dry-run": "node scripts/release-portal-update.cjs --dry-run",
    "release:update:local": "node scripts/release-portal-update.cjs --allow-unpublished",
    "release:verify": "node scripts/verify-release-surfaces.cjs",
    "cap:sync": "npx cap sync",
    "mobile:build": "npm run build && npx cap sync",
    "ios:open": "npx cap open ios",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@daily-co/daily-js": "^0.85.0",
    "@google/genai": "^1.30.0",
    "@supabase/supabase-js": "^2.83.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.554.0",
    "openai": "^6.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.1",
    "@parcel/transformer-inline-string": "^2.16.1",
    "@parcel/transformer-raw": "^2.16.1",
    "@parcel/transformer-webmanifest": "^2.16.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "parcel": "^2.0.0",
    "postcss": "^8.4.35",
    "process": "^0.11.10",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.1",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.brightforge.portal",
    "productName": "Bright Forge Portal",
    "artifactName": "BrightForgePortal-${version}-${arch}-${os}.${ext}",
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json",
      "assets/**/*",
      "preload.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "owner": "brightforgeseo",
      "repo": "bright-forge-management"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "assets/icon.ico"
    }
  }
}
